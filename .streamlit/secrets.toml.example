# Copy to .streamlit/secrets.toml (gitignored) and fill in. On Streamlit Community Cloud paste the same lines
# into the app's Settings > Secrets. SUPABASE_SECRET_KEY is server-only: never commit it or show it in the page.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_..."
SUPABASE_SECRET_KEY = "sb_secret_..."
SUPABASE_JWKS_URL = "https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json"
